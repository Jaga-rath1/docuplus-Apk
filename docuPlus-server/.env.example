# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Database URI (e.g. MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/docuPlusApp?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=your_super_secret_jwt_key_here

# Nodemailer / Gmail SMTP Configuration for OTP & Password Resets
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# CORS Configuration (optional, default: *)
CORS_ORIGIN=*
